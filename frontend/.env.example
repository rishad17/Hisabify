# Copy to .env.local (git-ignored) and fill in.
# Everything prefixed VITE_ is PUBLIC — it is bundled into the browser JS.

# FastAPI backend base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# Supabase dashboard → "Connect" (or Project Settings → API Keys).
# Public by design: data tables are protected by RLS and the backend's JWT checks.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The "publishable" key (sb_publishable_...). Older projects: the legacy "anon" key works too.
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
