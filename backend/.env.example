# Copy to .env (git-ignored). These are SERVER-SIDE secrets — never put them in the frontend.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Phase 1 ---
# Supabase Postgres connection string (Settings → Database → Connection string)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<host>:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co

# --- Phase 4 / 5 ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
