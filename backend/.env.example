# Copy to .env (git-ignored). These are SERVER-SIDE values — never put them in the frontend.

# development | test | production   (production hides /docs)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Supabase ---------------------------------------------------------------
# Project URL: Supabase dashboard → Project Settings → API (or the "Connect" button)
SUPABASE_URL=https://<project-ref>.supabase.co

# Postgres connection string: dashboard → "Connect" → "Session pooler" (port 5432).
# Use the POOLER string: it works over IPv4 (Render), the direct one may be IPv6-only.
# Replace [YOUR-PASSWORD] with the database password you chose (URL-encode symbols like @ # /).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Only for older projects that still sign tokens with the legacy JWT secret. Leave empty.
# SUPABASE_JWT_SECRET=

# SECRET admin key (Project Settings → API Keys → secret key, sb_secret_…).
# Only needed for "Delete my account". Never put it in the frontend.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Tests (optional) ---------------------------------------------------------
# A SEPARATE, disposable Postgres database. Tests DROP and recreate its schema!
# Never point this at your Supabase database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/takawise_test

# --- AI ----------------------------------------------------------------------
# Google AI Studio key (aistudio.google.com/apikey)
# GEMINI_API_KEY=
# Optional: Groq key for a Whisper speech-to-text fallback
# GROQ_API_KEY=
